# Kova server environment template.
# Copy to `.env`. Every KOVA_* name is canonical; the legacy names shown in
# comments are still accepted so existing deployments keep working.

# --- Runtime -----------------------------------------------------------------
FLASK_ENV=development
PORT=5000
# Waitress worker threads (dev default 4, production default 3)
# KOVA_WEB_THREADS=3

# --- Database ----------------------------------------------------------------
# legacy alias: MONGO_URI
KOVA_MONGO_URI=mongodb://localhost:27017/kova

# --- Auth --------------------------------------------------------------------
# REQUIRED in production — boot fails fast without it (built-in secret refused).
# legacy alias: JWT_SECRET_KEY
KOVA_JWT_SECRET=change-me-to-a-long-random-string
# KOVA_JWT_EXPIRES_SECONDS=3600
# Refresh tokens (issued by signup/login, exchanged by POST /api/auth/refresh)
# KOVA_JWT_REFRESH_EXPIRES_SECONDS=604800
# Development-only escape hatch if you must boot production with the default:
# KOVA_ALLOW_INSECURE_JWT=1

# --- Security ----------------------------------------------------------------
# CORS allowlist, comma-separated origins. Unset/empty = "*" (legacy parity).
# KOVA_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Upload cap for voice/PDF payloads (MB) → HTTP 413 above the limit.
# KOVA_MAX_UPLOAD_MB=16
# Gzip/brotli JSON & text responses >= 500 B when the client accepts them.
# KOVA_COMPRESS_ENABLED=true

# --- Rate limiting -----------------------------------------------------------
# Per-IP limits; 429 + JSON {"message": "Rate limit exceeded"} when breached.
# Health endpoints are always exempt (orchestrator probes).
# KOVA_RATELIMIT_ENABLED=true          # false turns limiting off entirely
# KOVA_RATELIMIT_DEFAULT=600 per minute   # applies to every route
# KOVA_RATELIMIT_AUTH=60 per minute       # signup/login/refresh/password
# KOVA_RATELIMIT_STORAGE_URI=memory://   # e.g. redis:// for multi-worker

# --- Error tracking (Sentry) -------------------------------------------------
# Unset = disabled (SDK never initialised). Set a DSN to report 500s.
# KOVA_SENTRY_DSN=https://hash@o0.ingest.sentry.io/0
# KOVA_SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR   (legacy alias: LOG_LEVEL)
# KOVA_LOG_LEVEL=INFO
# Console renderer: "text" = clean emoji UI (default) | "json" = log aggregators.
# KOVA_LOG_FORMAT=text

# --- AI integrations ---------------------------------------------------------
# legacy aliases: GROQ_API_KEY, ASSEMBLYAI_API_KEY, GROQ_LLM_URL
# Missing keys → AI endpoints answer 503 "AI provider is not configured".
KOVA_GROQ_API_KEY=
KOVA_ASSEMBLYAI_API_KEY=
# KOVA_GROQ_LLM_URL=https://api.groq.com/openai/v1/chat/completions
# KOVA_GROQ_MODEL=qwen/qwen3.8-27b
# KOVA_LLM_TIMEOUT_SECONDS=60

# --- OCR (camera / scan quick-add) -------------------------------------------
# Google Cloud Vision API key (enable "Cloud Vision API" on the GCP project).
# legacy alias: OCR_API_KEY
# Missing key -> POST /api/tasks/create/image answers 503.
KOVA_OCR_API_KEY=
# KOVA_OCR_URL=https://vision.googleapis.com/v1/images:annotate
# KOVA_OCR_TIMEOUT_SECONDS=60
# Uploads over 1 MB are rejected with 400 before any Vision call.

# --- Smart reminders & push --------------------------------------------------
# APScheduler delivers due reminders as in-app notifications + Expo push.
# KOVA_SCHEDULER_ENABLED=true
# KOVA_SCHEDULER_INTERVAL_SECONDS=30
# KOVA_PUSH_ENABLED=true
# KOVA_PUSH_URL=https://exp.host/--/api/v2/push/send
# Expo access token (set only if your Expo project enforces push security).
# KOVA_PUSH_ACCESS_TOKEN=

# --- Feature toggles ---------------------------------------------------------
# Auto-label manual tasks locally (no API key required). false disables it.
# KOVA_AUTO_CATEGORIZE=true

# --- Avatars -----------------------------------------------------------------
# Folder holding the selectable avatar files (default: app/assets/avatars).
# Drop .svg/.png/.jpg/.jpeg/.webp files in and they appear automatically in
# GET /api/users/avatars and can be picked via {"avatarId": "..."}.
# KOVA_AVATAR_DIR=
# User-uploaded photos (POST /api/users/profile/avatar, jpeg/png/webp <= 5 MB).
# Default: <server>/instance/avatar_uploads. Use a persistent volume in Docker.
# KOVA_AVATAR_UPLOAD_DIR=

# --- Password-reset mail (SMTP) ---------------------------------------------
# POST /api/auth/password/forgot mails a 6-digit code. Unset SMTP_HOST = no
# mail is sent (the code is logged at INFO only when FLASK_ENV=development).
# Port 465 uses implicit TLS; other ports upgrade with STARTTLS when offered.
# KOVA_SMTP_* aliases are also accepted.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Kova <no-reply@example.com>
