# ZenFlow server environment template.
# Copy to `.env`. Every ZENFLOW_* name is canonical; the legacy names shown in
# comments are still accepted so existing deployments keep working.

# --- Runtime -----------------------------------------------------------------
FLASK_ENV=development
PORT=5000
# Waitress worker threads (dev default 4, production default 3)
# ZENFLOW_WEB_THREADS=3

# --- Database ----------------------------------------------------------------
# legacy alias: MONGO_URI
ZENFLOW_MONGO_URI=mongodb://localhost:27017/zenflow

# --- Auth --------------------------------------------------------------------
# REQUIRED in production — boot fails fast without it (built-in secret refused).
# legacy alias: JWT_SECRET_KEY
ZENFLOW_JWT_SECRET=change-me-to-a-long-random-string
# ZENFLOW_JWT_EXPIRES_SECONDS=3600
# Refresh tokens (issued by signup/login, exchanged by POST /api/auth/refresh)
# ZENFLOW_JWT_REFRESH_EXPIRES_SECONDS=604800
# Development-only escape hatch if you must boot production with the default:
# ZENFLOW_ALLOW_INSECURE_JWT=1

# --- Security ----------------------------------------------------------------
# CORS allowlist, comma-separated origins. Unset/empty = "*" (legacy parity).
# ZENFLOW_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Upload cap for voice/PDF payloads (MB) → HTTP 413 above the limit.
# ZENFLOW_MAX_UPLOAD_MB=16
# Gzip/brotli JSON & text responses >= 500 B when the client accepts them.
# ZENFLOW_COMPRESS_ENABLED=true

# --- Rate limiting -----------------------------------------------------------
# Per-IP limits; 429 + JSON {"message": "Rate limit exceeded"} when breached.
# Health endpoints are always exempt (orchestrator probes).
# ZENFLOW_RATELIMIT_ENABLED=true          # false turns limiting off entirely
# ZENFLOW_RATELIMIT_DEFAULT=600 per minute   # applies to every route
# ZENFLOW_RATELIMIT_AUTH=60 per minute       # signup/login/refresh/password
# ZENFLOW_RATELIMIT_STORAGE_URI=memory://   # e.g. redis:// for multi-worker

# --- Error tracking (Sentry) -------------------------------------------------
# Unset = disabled (SDK never initialised). Set a DSN to report 500s.
# ZENFLOW_SENTRY_DSN=https://hash@o0.ingest.sentry.io/0
# ZENFLOW_SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR   (legacy alias: LOG_LEVEL)
# ZENFLOW_LOG_LEVEL=INFO

# --- AI integrations ---------------------------------------------------------
# legacy aliases: GROQ_API_KEY, ASSEMBLYAI_API_KEY, GROQ_LLM_URL
# Missing keys → AI endpoints answer 503 "AI provider is not configured".
ZENFLOW_GROQ_API_KEY=
ZENFLOW_ASSEMBLYAI_API_KEY=
# ZENFLOW_GROQ_LLM_URL=https://api.groq.com/openai/v1/chat/completions
# ZENFLOW_GROQ_MODEL=llama-3.3-70b-versatile
# ZENFLOW_LLM_TIMEOUT_SECONDS=60

# --- OCR (camera / scan quick-add) -------------------------------------------
# legacy alias: OCR_API_KEY
# Missing key -> POST /api/tasks/create/image answers 503.
ZENFLOW_OCR_API_KEY=
# ZENFLOW_OCR_URL=https://api.ocr.space/parse/image
# ZENFLOW_OCR_TIMEOUT_SECONDS=60

# --- Smart reminders & push --------------------------------------------------
# APScheduler delivers due reminders as in-app notifications + Expo push.
# ZENFLOW_SCHEDULER_ENABLED=true
# ZENFLOW_SCHEDULER_INTERVAL_SECONDS=30
# ZENFLOW_PUSH_ENABLED=true
# ZENFLOW_PUSH_URL=https://exp.host/--/api/v2/push/send
# Expo access token (set only if your Expo project enforces push security).
# ZENFLOW_PUSH_ACCESS_TOKEN=

# --- Feature toggles ---------------------------------------------------------
# Auto-label manual tasks locally (no API key required). false disables it.
# ZENFLOW_AUTO_CATEGORIZE=true

# --- Avatars -----------------------------------------------------------------
# Folder holding the selectable avatar files (default: app/assets/avatars).
# Drop .svg/.png/.jpg/.jpeg/.webp files in and they appear automatically in
# GET /api/users/avatars and can be picked via {"avatarId": "..."}.
# ZENFLOW_AVATAR_DIR=
